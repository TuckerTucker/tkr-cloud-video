# tkr-kit (local/machine-specific)
.tkr-kit/
.mcp.json
.claude/settings.local.json
CLAUDE.local.md
.claude/rules/tkr-kit

# Python environments and build output
.venv/
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]

# Quality-tool output
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Fetched job artifacts. scripts/fetch_result.sh takes its destination from the
# caller, so this is a convention rather than a path the code writes; an output
# video derived from a reference image is a likeness, and committing one would
# put personal information in git history where no retention period reaches it.
downloads/

# Local editor and operating-system state
.DS_Store
.idea/
.vscode/

# Local runtime secrets
.env
.env.*
.env_*
!.env.example
