{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tkr.example/schemas/release-manifest.schema.json",
  "title": "tkr-cloud-video release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "model_set_id", "created_at", "artifacts"],
  "properties": {
    "schema_version": { "const": "1" },
    "release_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "model_set_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "identity", "sha256", "verification_command"],
        "properties": {
          "name": { "type": "string" },
          "kind": {
            "enum": ["image", "python-lock", "comfyui", "custom-node", "workflow", "manifest", "model"]
          },
          "identity": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "verification_command": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
