{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tkr.example/schemas/generation-request.schema.json",
  "title": "tkr-cloud-video generation request",
  "oneOf": [
    {
      "$ref": "#/$defs/textToVideo"
    },
    {
      "$ref": "#/$defs/imageToVideo"
    },
    {
      "$ref": "#/$defs/referenceToVideo"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "mode",
        "workflow_id",
        "model_set_id",
        "seed"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "mode": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "model_set_id": {
          "type": "string",
          "description": "The model set to generate with. It selects the trained envelope that resolves width, height and frames, so it must name a model set with a registered envelope."
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4000,
          "description": "Freeform prompt. Supply exactly one of prompt or structured_prompt."
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "description": "Canvas width. Absent, it defaults to the long edge of the trained envelope of the model set named by model_set_id. The maximum and the required multiple are properties of that model set, not of this schema; a request naming a model set with no registered envelope is refused rather than given another model's numbers."
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "description": "Canvas height. Absent, it defaults to the short edge of the trained envelope of the model set named by model_set_id, with the same per-model-set maximum and multiple as width."
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "description": "Frame count at 24 fps. Absent, it defaults to the trained floor of the model set named by model_set_id. The temporal grid, the floor and the ceiling are properties of that model set. For minimax-h3-t2v-int8-20260809 the grid is 17k+5 and the trained range is 124-362; below the floor is permitted and reported as a departure from the trained envelope, above the ceiling is refused."
        },
        "fps": {
          "const": 24,
          "default": 24
        },
        "structured_prompt": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "https://tkr.example/schemas/h3-prompt.schema.json",
          "description": "Structured H3 prompt. Validated, rendered, and digested server-side."
        }
      },
      "oneOf": [
        {
          "required": [
            "prompt"
          ],
          "properties": {
            "structured_prompt": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "structured_prompt"
          ],
          "properties": {
            "prompt": {
              "type": "null"
            }
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_key"
      ],
      "properties": {
        "object_key": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "textToVideo": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "mode": {
              "const": "text-to-video"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "imageToVideo": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "required": [
            "image"
          ],
          "properties": {
            "mode": {
              "const": "image-to-video"
            },
            "image": {
              "$ref": "#/$defs/input"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "referenceToVideo": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "required": [
            "references"
          ],
          "properties": {
            "mode": {
              "const": "reference-to-video"
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/input"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
